module bitcoin_wallet_backend {
  version "0.1.0"
  depends []

  method configure(roles_json: tstr) -> tstr description "CUSTODIAN. Replaces the custodian set, `{ custodians }`: total (`{}` is nobody), unknown\nkeys refused, saved to roles.json. `{ ok, custodians }`."
  method caller_identity() -> tstr description "`{ ok, kind, identity, custodians, rolesFile }`: who this call came from, who holds the\nrole, and the file a headless operator writes to enrol a module."
  method list_networks() -> tstr description "`{ ok, networks, active, pending }`; `pending` is a switch waiting for a close to settle."
  method set_active_network(network: tstr) -> tstr description "CUSTODIAN. While a close settles the switch is queued: `{ ok, active, pending }`, and opens are\nrefused with code busy until it applies. Refusals carry `code`: busy, wallet_open, send_open."
  method list_wallets() -> tstr description "`{ ok, active, wallets: [{ group, family, network, label, birthday, gapLimit, firstOpened, lastOpened }] }`:\nwallets opened before, newest first. No secrets."
  method open_wallet(params_json: tstr) -> tstr description "CUSTODIAN. `{ network?, group?, family?, birthday?, label?, gapLimit? }` on the active network; gapLimit\n20 to 1000, else the core's 20 or the wallet's stored one. `{ ok, jobId }`; wallet_status carries\n`openHandle` while the person decides in the keys app."
  method close_wallet() -> tstr description "CUSTODIAN. Withdraws open sends first; refused while one is going out. `{ ok, jobId }`."
  method job_status(job_id: tstr) -> tstr description "`{ ok, jobId, kind, state: queued|running|done|failed|cancelled, result?, error? }`."
  method descriptors() -> tstr description "CUSTODIAN. The open wallet's public descriptors, as a call result only, never an event."
  method set_birthday(params_json: tstr) -> tstr description "CUSTODIAN. `{ date: \"YYYY-MM-DD\" }` or `{ height }` for the open wallet; the core scans again from\nit. `{ ok, jobId }`; the job's result is `{ birthday: { height, source }, rescanFrom }`."
  method set_gap_limit(params_json: tstr) -> tstr description "CUSTODIAN. `{ gapLimit }`, 20 to 1000, for the open wallet; a raise scans again from the birthday.\n`{ ok, jobId }`; the job's result is `{ gapLimit, rescanFrom }`. Refusal codes: invalid, busy, no_wallet."
  method wallet_status() -> tstr description "The core's status, `gapLimit` included, plus `syncPercent`, `activeNetwork`, `label` and `openSend`."
  method balances() -> tstr description "`{ ok, busy, confirmed, waiting, pending, sent, immature, tooSmall, beyondGap: { count, sat, confirmedSat } }`\nin satoshis, each with a `…Btc` twin. beyondGap is coins past the gap limit, confirmedSat its confirmed\npart: outside confirmed, waiting, pending and sent, still spendable. Empty while busy, never zero."
  method history(page: int) -> tstr description "The core's history page, newest first; rows gain `amountBtc` and `feeBtc`, and keep `beyondGap` (false\nunless the wallet's part is only through addresses past the gap limit)."
  method receive_address() -> tstr description "`{ ok, address, index }`: a fresh receive address."
  method fee_rates() -> tstr description "`{ ok, fast, normal, slow, minimum, sources }` in sat/vB."
  method address_valid(text: tstr) -> tstr description "An address or BIP21 URI on the wallet's network: `{ ok, valid, address, type, amountSat?, reason? }`."
  method format_btc(sat: tstr) -> tstr description "Satoshis, a decimal string, as BTC: `{ ok, sat, btc }`."
  method parse_btc(btc: tstr) -> tstr description "BTC as satoshis, exactly; more than 8 decimals is refused. `{ ok, btc, sat }`."
  method sources() -> tstr description "The node module's sources for the wallet's network."
  method source_health() -> tstr description "The node module's source health, plus `wallet`, the open wallet's own view of them."
  method probe(params_json: tstr) -> tstr description "`{ network?, source }`: the node module probes that source now, or every enabled server for \"\",\nwithin 15 s; a TLS server's row carries `certificate`."
  method exposure() -> tstr description "The servers that have seen the open wallet's addresses, and since when."
  method set_sources(list_json: tstr) -> tstr description "CUSTODIAN. Replaces the network's sources, a JSON array. Refused while a wallet is open."
  method set_source(source_id: tstr, changes_json: tstr) -> tstr description "CUSTODIAN. `{ use?, history?, tor? }` for one source. Refused while a wallet is open."
  method set_proxy(proxy: tstr) -> tstr description "CUSTODIAN. The Tor proxy for every source, socks5h://host:port. Refused while a wallet is open."
  method clear_suspect(source_id: tstr) -> tstr description "CUSTODIAN. Clears a suspect mark in the node module and, with a wallet open, in the core."
  method set_own_peers(params_json: tstr) -> tstr description "CUSTODIAN. `{ network, peers: [host[:port]] }`, at most 64: Kyoto's own peers, which replace the\ncurated list (`[]` restores it). Refused while a wallet is open. Answers as peer_list."
  method peer_list(params_json: tstr) -> tstr description "CUSTODIAN. `{ network? }`: the node module's peer list, with `ownPeers` and `usable`."
  method request_send(request_json: tstr) -> tstr description "Any named module. `{ recipients: [{ address, amountSat | amountBtc }], feeRate? | target?,\nsendMax? }` → `{ ok, requestId }`. One open send per wallet."
  method request_fee_bump(request_json: tstr) -> tstr description "Any named module. `{ txid, feeRate }` replaces an unconfirmed send with RBF, approved like\nany send. `{ ok, requestId }`."
  method send_status(request_id: tstr) -> tstr description "`{ ok, requestId, kind, state, requester, summary, approvalHandle, txid, broadcast, via, error, errorCode,\ncancelling }`; states preparing, awaiting_approval, committing, sent, failed, cancelled, unknown."
  method list_sends() -> tstr description "`{ ok, sends: [{ requestId, kind, state, requester, approvalHandle, txid, errorCode, createdAt, updatedAt }] }`, newest first."
  method cancel_send(request_id: tstr) -> tstr description "The requester or a custodian. Withdraws the approval request and unlocks the inputs;\nrefused once the transaction is going out. `{ ok, requestId, state, cancelling }`."
  method rebroadcast(request_or_txid: tstr) -> tstr description "CUSTODIAN. Broadcasts a send's transaction again, named by request id or txid. `{ ok, jobId }`."
  method abandon_send(params_json: tstr) -> tstr description "CUSTODIAN. `{ txid }` of a send in `unknown`: the core frees its coins. `{ ok, jobId, requestId,\ntxid, note }`; if the original still confirms, a later send from them fails, or replaces it first."

  event wallet_state_changed(payload: tstr) description "wallet_status()'s shape, whenever the core's state changes."
  event sync_progress(payload: tstr) description "`{ state, network, walletTip, authorityHeight, tipAgeSecs, percent, synced }`, on change."
  event balance_changed(payload: tstr) description "balances()'s shape, when an amount the core read changes."
  event send_status_changed(request_id: tstr, state: tstr)
  event job_finished(job_id: tstr, state: tstr) description "Opens, closes and rebroadcasts, under the backend's job ids."
  event source_alert(payload: tstr) description "The core's alert about a source: `{ source, kind, detail, at, network, group }`."
}
